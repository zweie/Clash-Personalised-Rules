name: Rule Provider
desc: 2025/12/13

rule-providers: #!replace

  anti-AD:
    type: http
    format: yaml
    behavior: domain
    url: "https://anti-ad.net/clash.yaml"
    path: "./ruleset/AD/anti-AD.yaml"
    interval: 86400
  
  Tracker_IP:
    type: http
    format: yaml
    behavior: ipcidr
    url: "https://raw.githubusercontent.com/zweie/Clash-Personalised-Rules/rules/Providers/Trackers/trackers_all_ip.yaml"
    path: "./ruleset/Tracker/Tracker_IP.yaml"
    interval: 86400

  Tracker_Domain:
    type: http
    format: yaml
    behavior: domain
    url: "https://raw.githubusercontent.com/zweie/Clash-Personalised-Rules/rules/Providers/Trackers/trackers_all.yaml"
    path: "./ruleset/Tracker/Tracker_Domain.yaml"
    interval: 86400

  DOH_Direct:
    type: http
    format: yaml
    behavior: domain
    url: "https://raw.githubusercontent.com/zweie/Clash-Personalised-Rules/rules/Providers/DNS/doh_able.yaml"
    path: "./ruleset/DOH/DOH_Direct.yaml"
    interval: 86400

  DOH_Proxy:
    type: http
    format: yaml
    behavior: domain
    url: "https://raw.githubusercontent.com/zweie/Clash-Personalised-Rules/rules/Providers/DNS/doh_unable.yaml"
    path: "./ruleset/DOH/DOH_Proxy.yaml"
    interval: 86400

  DOH_Proxy_IP:
    type: http
    format: yaml
    behavior: ipcidr
    url: "https://raw.githubusercontent.com/zweie/Clash-Personalised-Rules/rules/Providers/DNS/doh_unable_ip.yaml"
    path: "./ruleset/DOH/DOH_Proxy_IP.yaml"
    interval: 86400

  Mirrors_Direct:
    type: http
    format: yaml
    behavior: domain
    url: "https://raw.githubusercontent.com/zweie/Clash-Personalised-Rules/rules/Providers/mirrors/direct.yaml"
    path: "./ruleset/Mirrors/Mirrors_Direct.yaml"
    interval: 86400

  Mirrors_Proxy:
    type: http
    format: yaml
    behavior: domain
    url: "https://raw.githubusercontent.com/zweie/Clash-Personalised-Rules/rules/Providers/mirrors/proxy.yaml"
    path: "./ruleset/Mirrors/Mirrors_Proxy.yaml"
    interval: 86400

  Extra_Direct:
    type: http
    format: yaml
    behavior: classical
    url: "https://raw.githubusercontent.com/zweie/Clash-Personalised-Rules/rules/Providers/extra/Direct.yaml"
    path: "./ruleset/Extra/Extra_Direct.yaml"
    interval: 86400

  Extra_Block:
    type: http
    format: yaml
    behavior: classical
    url: "https://raw.githubusercontent.com/zweie/Clash-Personalised-Rules/rules/Providers/extra/Block.yaml"
    path: "./ruleset/Extra/Extra_Block.yaml"
    interval: 86400